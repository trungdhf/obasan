# --- Gemini ---
GEMINI_API_KEY=            # AI Studio key (ai.google.dev). Required for real Live + TTS.
LIVE_MODEL=gemini-2.5-flash-preview-native-audio-dialog
LIVE_VOICE=Leda            # youthful prebuilt voice
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Leda

# --- Storage ---
GOOGLE_CLOUD_PROJECT=      # set → Firestore; unset → in-memory demo store

# --- LINE Messaging API ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_IDS=           # comma-separated userId/groupId receiving family alerts

# --- Agent behaviour ---
IDLE_TO_STANDBY_SEC=45
CALL_ATTEMPTS=3
QUIET_HOURS=22-7           # JST range when reminders don't fire
JOB_SECRET=                # header x-job-secret checked by /jobs/due (Cloud Scheduler)
PORT=8080
