# --- Gemini: pick ONE mode ---

# Vertex AI (recommended for the hackathon — Google Cloud credits apply here).
# Also enables the Firestore store. On Cloud Run auth is automatic via the
# service account; locally run `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1   # Vertex region for Live/TTS

# AI Studio (local dev / demo without GCP). Ephemeral-token Live + TTS.
GEMINI_API_KEY=

# Model defaults follow the mode; override only if needed.
# Vertex Live default:  gemini-live-2.5-flash-preview-native-audio-09-2025
# AI Studio default:    gemini-2.5-flash-preview-native-audio-dialog
LIVE_MODEL=
LIVE_VOICE=Leda            # youthful prebuilt voice
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Leda

# --- LINE Messaging API ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_IDS=           # comma-separated userId/groupId receiving family alerts

# --- Agent behaviour ---
IDLE_TO_STANDBY_SEC=45
CALL_ATTEMPTS=3
QUIET_HOURS=22-7           # JST range when reminders don't fire
JOB_SECRET=                # header x-job-secret checked by /jobs/due (Cloud Scheduler)
PORT=8080
